# FastAPI Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Path to trained PyTorch ResNet18 Disease Classification Model weights (.pth)
# Place your trained disease_resnet18.pth inside the backend/models directory
DISEASE_MODEL_PATH=models/disease_resnet18.pth

# Path to trained Ultralytics YOLO Pest Detection Model (.pt)
# Place your pest_best.pt inside the backend/models directory when ready
PEST_MODEL_PATH=models/pest_best.pt

# YOLO Pest Detection Confidence Threshold (0.0 to 1.0)
PEST_CONFIDENCE_THRESHOLD=0.35

# Storage directory for analysis results and annotated images
STORAGE_DIR=storage/results

# Model uncertainty threshold (below this confidence, a caution warning is flagged)
UNCERTAINTY_THRESHOLD=0.60
